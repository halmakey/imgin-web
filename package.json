{
  "name": "imgin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "pages:build": "$npm_execpath exec @cloudflare/next-on-pages",
    "preview": "$npm_execpath run pages:build && wrangler pages dev",
    "deploy": "$npm_execpath run pages:build && wrangler pages deploy",
    "cf-typegen": "wrangler types --include-runtime=false --env-interface CloudflareEnv env.d.ts",
    "migrate:local": "wrangler d1 migrations apply imgin-db --local",
    "migrate:remote": "wrangler d1 migrations apply imgin-db --remote"
  },
  "dependencies": {
    "@heroicons/react": "^2.1.5",
    "date-fns": "^3.6.0",
    "mp4-muxer": "5.2.2",
    "nanoid": "^5.1.16",
    "next": "15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "swr": "^2.5.1"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "1.13.15",
    "@cloudflare/workers-types": "^4.20240815.0",
    "@types/node": "^20",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "eslint": "^8",
    "eslint-config-next": "14.2.5",
    "eslint-plugin-next-on-pages": "^1.13.2",
    "postcss": "^8",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.6",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.4",
    "vercel": "^36.0.0",
    "wrangler": "4.107.1"
  },
  "overrides": {
    "@cloudflare/next-on-pages": {
      "miniflare": "4.20260702.0",
      "esbuild": "0.28.1"
    },
    "@tootallnate/once@2": "^2.0.1",
    "ajv@8": "^8.18.0",
    "brace-expansion@1": "^1.1.21",
    "cookie@0": "^0.7.2",
    "debug@4": "^4.4.3",
    "esbuild@0.14": "0.28.1",
    "glob@10": "^10.5.0",
    "path-to-regexp@6": "^6.3.0",
    "postcss": "$postcss",
    "semver@7": "^7.7.0",
    "sharp": "^0.35.5",
    "tar": "^7.5.24",
    "undici@5": "^6.29.1",
    "undici@7": "^7.30.1",
    "ws@8": "^8.21.0"
  }
}
